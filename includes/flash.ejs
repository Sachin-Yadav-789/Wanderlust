 <!-- here when (success) exsit and he have some length, (length>0) then it work -->
 <% if(success && success.length){ %> 
   <div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-3" role="alert">
    <b><%= success %>   </b> 
        <button 
           type="button" 
           class="btn-close"
            data-bs-dismiss="alert" 
            aria-label="Close">
        </button>
 </div>
 <% } %> 


  <% if(error && error.length){ %> 
   <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-3" role="alert">
    <b><%= error %>   </b> 
        <button 
           type="button" 
           class="btn-close"
            data-bs-dismiss="alert" 
            aria-label="Close">
        </button>
 </div>
 <% } %> 